@page "/PlotlyMaps"
@inherits DemoBaseComponent

<h2>Plotly Map Chart Examples.</h2>
<table>
    
    <!-- this is an extremely simple layout, I'll leave advanced layouts to the experts -->
    
    <tr><td width="800px" valign="top"><br />
    
        <!-- Plotly chart component-->
        <PlotlyChart @ref="Chart1"></PlotlyChart>
        
    </td><td>&nbsp;</td><td>


   
     <h3>Maps</h3>

        <button class="btn btn-primary m-1" @ref="firstButton" id="FirstButton" disabled="@DisabledButtons" @onclick="ChoroplethChart">Choropleth</button>

        <button class="btn btn-primary m-1" disabled="@DisabledButtons" @onclick="ChoroplethMapChart">Choropleth Map</button>

        <button class="btn btn-primary m-1" disabled="@DisabledButtons" @onclick="DensityMapChart">Density Map</button>

        <button class="btn btn-primary m-1" disabled="@DisabledButtons" @onclick="ScatterMapChart">Scatter Map</button>

  

     <h3>Geo</h3>

        <button class="btn btn-primary m-1" disabled="@DisabledButtons" @onclick="LineGeoChart">Line Geo</button>

        <button class="btn btn-primary m-1" disabled="@DisabledButtons" @onclick="ScatterGeoChart">Geo</button>

 
    </td></tr></table>
