@page "/PlotlySimple"
@inherits DemoBaseComponent

<h2>Plotly Simple Chart Examples.</h2>
<table>
    
    <!-- this is an extremely simple layout, I'll leave advanced layouts to the experts -->
    
    <tr><td width="800px" valign="top"><br />
    
        <!-- Plotly chart component-->
        <PlotlyChart @ref="Chart1"></PlotlyChart>
        
    </td><td>&nbsp;</td><td>



    <h3>Line and Scatter</h3>

        <button class="btn btn-primary m-1" @ref="firstButton" id="FirstButton" disabled="@DisabledButtons" @onclick="ScatterChart">Scatter</button>

        <button class="btn btn-primary m-1" disabled="@DisabledButtons" @onclick="LogScatterChart">Log Scatter</button>

        <button class="btn btn-primary m-1" disabled="@DisabledButtons" @onclick="TimeSeriesChart">Time Series</button>

        <button class="btn btn-secondary m-1" disabled="@DisabledButtons" @onclick="() => GenericRestyle(1000)">Generic Restyle 1K</button>

        <button class="btn btn-secondary m-1" disabled="@DisabledButtons" @onclick="() => GenericRestyle(10000)">Generic Restyle 10K</button>

        <button class="btn btn-secondary m-1" disabled="@DisabledButtons" @onclick="() => GenericRestyle(100000)">Generic Restyle 100K</button>

        <button class="btn btn-secondary m-1" disabled="@DisabledButtons" @onclick="() => ByteRestyle(1000)">Byte Restyle 1K</button>

        <button class="btn btn-secondary m-1" disabled="@DisabledButtons" @onclick="() => ByteRestyle(10000)">Byte Restyle 10K</button>

        <button class="btn btn-secondary m-1" disabled="@DisabledButtons" @onclick="() => ByteRestyle(100000)">Byte Restyle 100K</button>

        <button class="btn btn-warning m-1" disabled="@DisabledButtons" @onclick="BurstRestyle">Burst Restyle</button>

        <span class="m-1">@UpdateStatus</span>

    <h3>Region</h3>

        <button class="btn btn-primary m-1" disabled="@DisabledButtons" @onclick="BubbleChart">Bubble</button>

        <button class="btn btn-primary m-1" disabled="@DisabledButtons" @onclick="BarChart">Bar</button>

        <button class="btn btn-primary m-1" disabled="@DisabledButtons" @onclick="PieChart">Pie</button>


    



 
    </td></tr></table>
